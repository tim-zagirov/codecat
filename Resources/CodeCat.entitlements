<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime is required for notarisation, and by default it forbids the
         process from sending Apple events to anyone. Without this key, jumping to a
         session (SystemJumpExecutor: NSAppleScript + AEDeterminePermissionToAutomateTarget)
         fails with errAEEventNotPermitted -1743 — and it does so REGARDLESS of what the
         user allowed under System Settings → Privacy & Security → Automation. This
         cannot be noticed on an ad-hoc build: there is no hardened runtime there and
         everything works. What breaks is precisely what ships to people. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
